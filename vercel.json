{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).rsc",
      "headers": [{ "key": "Content-Type", "value": "text/x-component" }]
    }
  ]
}
